# ─── Financial Dashboard Client – Environment Variables ──────────────────────
# Copy this file to .env and fill in your values.

# Backend API base URL (used when NOT proxying through Vite)
VITE_API_BASE_URL=http://localhost:5000

# Polling interval for live price refresh (milliseconds, default 60000 = 1 min)
VITE_POLL_INTERVAL_MS=60000
