# ─── Financial Dashboard API – Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is loaded automatically by Program.cs in development.
# In production, set these as real environment variables or use dotnet user-secrets.

# Finnhub API key (free tier at https://finnhub.io)
Finnhub__ApiKey=your_finnhub_api_key_here

# SendGrid (https://sendgrid.com) – for email alerts & reports
SendGrid__ApiKey=your_sendgrid_api_key_here
SendGrid__FromEmail=noreply@yourdomain.com
SendGrid__FromName=Financial Dashboard

# Frontend origin allowed by CORS (must match Vite dev server port)
AllowedOrigins=http://localhost:5173

# SQLite file paths (relative to the working directory)
Database__Path=financial_dashboard.db
